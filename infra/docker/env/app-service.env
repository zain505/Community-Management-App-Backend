NODE_ENV=production
SERVICE_NAME=app-service
PORT=4400
LOG_LEVEL=info
CORS_ORIGINS=http://hzhtechco.site,https://hzhtechco.site,http://www.hzhtechco.site,https://www.hzhtechco.site,capacitor://localhost,ionic://localhost,http://localhost,https://localhost,http://localhost:3000,http://localhost:5173
DATABASE_URL=mysql://root:root@mysql:3306/app_db
AUTH_SERVICE_BASE_URL=http://auth-service:4100
AUTH_SERVICE_TIMEOUT_MS=10000
NEWSFEED_SERVICE_BASE_URL=http://newsfeed-service:4300
NEWSFEED_SERVICE_TIMEOUT_MS=10000
JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
AWT_ANDROID_LATEST_BUILD=
AWT_ANDROID_MINIMUM_SUPPORTED_BUILD=
AWT_ANDROID_RECOMMENDED_BUILD=
AWT_ANDROID_FORCE_UPDATE=false
AWT_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.zain505.awt
AWT_ANDROID_UPDATE_TITLE=Update required
AWT_ANDROID_UPDATE_MESSAGE=A newer version of the app is required to continue.
