# Root development env. All services load this file.
# Service-prefixed keys are mapped to PORT and DATABASE_URL inside each service.
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000
API_GATEWAY_URL=http://localhost:4000
CORS_ORIGINS=capacitor://localhost,ionic://localhost,http://localhost,https://localhost,http://localhost:3000,http://localhost:4000,http://localhost:5173
TRUST_PROXY=loopback

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000

JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4100
STORE_SERVICE_PORT=4200
NEWSFEED_SERVICE_PORT=4300
APP_SERVICE_PORT=4400

AUTH_SERVICE_URL=http://127.0.0.1:4100
STORE_SERVICE_URL=http://127.0.0.1:4200
NEWSFEED_SERVICE_URL=http://127.0.0.1:4300
APP_SERVICE_URL=http://127.0.0.1:4400
AUTH_SERVICE_BASE_URL=http://127.0.0.1:4100
STORE_SERVICE_BASE_URL=http://127.0.0.1:4200
NEWSFEED_SERVICE_BASE_URL=http://127.0.0.1:4300
APP_SERVICE_BASE_URL=http://127.0.0.1:4400
AUTH_SERVICE_TIMEOUT_MS=10000
STORE_SERVICE_TIMEOUT_MS=10000
NEWSFEED_SERVICE_TIMEOUT_MS=10000
PROXY_TIMEOUT_MS=10000
CHAT_ATTACHMENT_PROXY_TIMEOUT_MS=60000

API_GATEWAY_DATABASE_URL=mysql://root:root@127.0.0.1:3306/auth_db
AUTH_DATABASE_URL=mysql://root:root@127.0.0.1:3306/auth_db
STORE_DATABASE_URL=mysql://root:root@127.0.0.1:3306/store_db
NEWSFEED_DATABASE_URL=mysql://root:root@127.0.0.1:3306/newsfeed_db
APP_DATABASE_URL=mysql://root:root@127.0.0.1:3306/app_db

STORE_LIST_CACHE_TTL_SECONDS=60
STORE_SEARCH_SYNC_DEBOUNCE_SECONDS=15
NEWSFEED_LIST_CACHE_TTL_SECONDS=30
NEWSFEED_LIST_CACHE_MAX_PAYLOAD_BYTES=512000

AWT_ANDROID_LATEST_BUILD=5
AWT_ANDROID_MINIMUM_SUPPORTED_BUILD=5
AWT_ANDROID_RECOMMENDED_BUILD=5
AWT_ANDROID_FORCE_UPDATE=true
AWT_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.zain505.awt
AWT_ANDROID_UPDATE_TITLE=Update required
AWT_ANDROID_UPDATE_MESSAGE=A newer version of the app is required to continue.
