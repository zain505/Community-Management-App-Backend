NODE_ENV=production
SERVICE_NAME=newsfeed-service
# PM2 can override this, but 4300 is the default private newsfeed-service port.
PORT=4300
LOG_LEVEL=info
CORS_ORIGINS=http://hzhtechco.site,https://hzhtechco.site,http://www.hzhtechco.site,https://www.hzhtechco.site,http://localhost:3000,http://localhost:5173
DATABASE_URL=mysql://community_user:change-this-password@127.0.0.1:3306/newsfeed_db
JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
# Newsfeed service talks to auth-service and store-service over loopback on the same VPS.
AUTH_SERVICE_BASE_URL=http://127.0.0.1:4100
AUTH_SERVICE_TIMEOUT_MS=10000
STORE_SERVICE_BASE_URL=http://127.0.0.1:4200
STORE_SERVICE_TIMEOUT_MS=10000
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
NEWSFEED_LIST_CACHE_TTL_SECONDS=30
NEWSFEED_LIST_CACHE_MAX_PAYLOAD_BYTES=512000
