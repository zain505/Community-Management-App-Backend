NODE_ENV=production
SERVICE_NAME=store-service
# PM2 can override this, but 4200 is the default private store-service port.
PORT=4200
LOG_LEVEL=info
CORS_ORIGINS=http://hzhtechco.site,https://hzhtechco.site,http://www.hzhtechco.site,https://www.hzhtechco.site,http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=https://hzhtechco.site
DATABASE_URL=mysql://community_user:change-this-password@127.0.0.1:3306/store_db
JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
# Store service talks to auth-service and newsfeed-service over loopback on the same VPS.
AUTH_SERVICE_BASE_URL=http://127.0.0.1:4100
AUTH_SERVICE_TIMEOUT_MS=10000
NEWSFEED_SERVICE_BASE_URL=http://127.0.0.1:4300
NEWSFEED_SERVICE_TIMEOUT_MS=10000
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
STORE_LIST_CACHE_TTL_SECONDS=60
STORE_SEARCH_SYNC_DEBOUNCE_SECONDS=15
