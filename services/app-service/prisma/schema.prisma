generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ChatMessageType {
  text
  image
  audio
}

enum ChatAttachmentType {
  image
  audio
}

enum ChatAttachmentStatus {
  uploaded
  attached
  expired
  deleted
}

model User {
  id            String         @id @default(cuid())
  mobileNumber  String         @unique
  name          String
  usertype      Int            @default(2)
  passwordHash  String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Announcement {
  id              String   @id @default(cuid())
  title           String
  content         String   @db.Text
  authorName      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String

  @@index([createdByUserId])
  @@index([createdAt])
  @@index([title])
}

model EventManagement {
  id              String    @id @default(cuid())
  title           String
  description     String    @db.Text
  image           String    @db.LongText
  location        String
  startAt         DateTime
  endAt           DateTime?
  authorName      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String

  @@index([createdByUserId])
  @@index([createdAt])
  @@index([startAt])
  @@index([title])
}

model ChatMessage {
  id              String           @id @default(cuid())
  type            ChatMessageType  @default(text)
  content         String           @db.Text
  authorName      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdByUserId String
  attachments     ChatAttachment[]

  @@index([createdAt])
  @@index([createdByUserId])
}

model ChatAttachment {
  id              String               @id @default(cuid())
  type            ChatAttachmentType
  url             String
  storagePath     String
  mimeType        String
  fileName        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationMillis  Int?
  status          ChatAttachmentStatus @default(uploaded)
  expiresAt       DateTime?
  consumedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdByUserId String
  messageId       String?
  message         ChatMessage?         @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([expiresAt])
  @@index([messageId])
  @@index([createdByUserId, status])
}
