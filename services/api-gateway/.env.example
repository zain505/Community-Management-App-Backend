NODE_ENV=production
SERVICE_NAME=api-gateway
# Nginx should proxy requests to this public gateway port on the VPS.
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://hzhtechco.site,https://hzhtechco.site,http://www.hzhtechco.site,https://www.hzhtechco.site,http://localhost:3000,http://localhost:5173
# Trust the reverse proxy in front of the gateway so req.ip/rate limiting use the real client IP.
TRUST_PROXY=1
DATABASE_URL=mysql://community_user:change-this-password@127.0.0.1:3306/auth_db
JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
# The gateway reaches the private services over loopback on the same VPS.
AUTH_SERVICE_URL=http://127.0.0.1:4100
STORE_SERVICE_URL=http://127.0.0.1:4200
STORE_SERVICE_TIMEOUT_MS=10000
NEWSFEED_SERVICE_URL=http://127.0.0.1:4300
APP_SERVICE_URL=http://127.0.0.1:4400
PROXY_TIMEOUT_MS=10000
