# This root-level file is only a reference snapshot.
# Runtime services load env files from services/*/.env instead.
# Use `npm run env:setup` to create missing service env files.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated allowed origins for CORS
CORS_ORIGINS=capacitor://localhost,ionic://localhost,http://localhost,https://localhost,http://localhost:3000,http://localhost:5173

# MySQL for local non-Docker auth-service
DATABASE_URL=mysql://root:root@127.0.0.1:3306/auth_db

# JWT secrets must be long random strings (>= 32 chars)
JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# App-service AWT mobile version policy
AWT_ANDROID_LATEST_BUILD=5
AWT_ANDROID_MINIMUM_SUPPORTED_BUILD=5
AWT_ANDROID_RECOMMENDED_BUILD=5
AWT_ANDROID_FORCE_UPDATE=true
AWT_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.zain505.awt
AWT_ANDROID_UPDATE_TITLE=Update required
AWT_ANDROID_UPDATE_MESSAGE=A newer version of the app is required to continue.
